DISCORD_BOT_TOKEN="your_discord_bot_token_here"

# Command cooldowns in seconds. 0 disables a cooldown.
CREATE_TIMEOUT=300
PING_TIMEOUT=60

# Presence, all optional.
# BOT_STATUS: online, idle, dnd, invisible
# BOT_STATUS=online
# BOT_ACTIVITY_TYPE: playing, watching, listening, streaming, competing
# BOT_ACTIVITY_TYPE=playing
# BOT_ACTIVITY_NAME=with dice
# BOT_ACTIVITY_URL is required for the streaming activity type (Twitch/YouTube).
# BOT_ACTIVITY_URL=https://www.twitch.tv/username
